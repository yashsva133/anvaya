+/** First rule whose keys match the question, or null. */
+export function matchRules(q: string): { matched: string; a: Answer } | null {
+  const rule = RULES.find((r) => r.keys.test(q));
+  return rule ? { matched: rule.a.matched, a: rule.a } : null;
+}
