+// The original response was { ok: true, mode: "demo", database: "not-configured" }.
+// Those three fields are kept so anything reading them still works; the rest is
+// additive. This route does NOT call the model — use /api/ai/status for that,
+// which pings the provider and reports latency.
+
+import { loadAiEnv } from "@/lib/ai/env";
+import { chunkCount } from "@/lib/ai/rag";
+import { PROMPT_VERSION } from "@/lib/ai/prompts";
+
 export const dynamic = "force-dynamic";
 
 export async function GET() {
