   return Response.json({
     ok: true,
-    mode: "demo",
-    database: "not-configured",
+    mode: env.live ? "live" : "demo",
+    database: env.persistence ? "supabase" : "not-configured",
+    ai: {
+      provider: env.ai.provider,
+      model: env.ai.model,
+      prompt_version: PROMPT_VERSION,
