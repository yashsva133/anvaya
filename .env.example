# ---------------------------------------------------------------------------
# Anvaya — MedGemma chatbot configuration
# Copy to .env.local and fill in. .env.local is git-ignored; never commit keys.
#
# With NO variables set the app still runs: /api/answer falls back to the
# deterministic rule answers and /api/health reports mode "demo".
# ---------------------------------------------------------------------------

# ---- Which inference backend to call ---------------------------------------
# ollama | openai | vllm | vertex | mock | none
#   ollama  - `ollama serve` with `ollama pull medgemma` (the expected default)
#   openai  - any OpenAI-compatible server, e.g. `vllm serve google/medgemma-4b-it`
#   vllm    - alias for openai
#   vertex  - hosted MedGemma endpoint
#   mock    - no model; exercises the pipeline for development
#   none    - rule answers only
# Unset, this is inferred from whichever *_BASE_URL is present.
AI_PROVIDER=ollama

# Base URL of the inference server. Ollama's default is shown.
AI_BASE_URL=http://127.0.0.1:11434

# Model id. Ollama: "medgemma:4b" or "medgemma:27b".
# vLLM: "google/medgemma-4b-it".
AI_MODEL=medgemma:4b

# Bearer token, for openai/vllm/vertex providers. Ollama needs none.
# AI_API_KEY=

# ---- Generation ------------------------------------------------------------
# Low on purpose: MedGemma ships without safety filters, so the guardrail layer
# in src/lib/ai/guardrails.ts owns safety and a low temperature keeps the model
# on the supplied facts rather than elaborating.
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=512
AI_TIMEOUT_MS=45000

# ---- Retrieval -------------------------------------------------------------
AI_TOP_K=3
AI_MIN_SCORE=0.3
# Recorded verbatim into ai_generations.trust_formula so a later change in
# weighting cannot silently reinterpret older scores.
AI_TRUST_FORMULA=0.6*model + 0.4*retrieval

# Set to 1 to answer from the deterministic rules when they match, and only call
# the model when they miss. Useful for demos with limited GPU.
AI_RULES_FIRST=0

# ---- Voice agent (optional) -------------------------------------------------
# The voice agent works with NO variables set: it uses the browser's own
# SpeechRecognition (Chrome/Edge/Safari) and speechSynthesis. These two blocks
# only fill the gaps those APIs leave — see AI_VOICE_AGENT_RUNBOOK.md.
#
# Server-side speech-to-text. Needed for Firefox, which has no SpeechRecognition.
# Any OpenAI-compatible /audio/transcriptions endpoint: OpenAI, Groq, Together,
# or a self-hosted faster-whisper server.
# STT_BASE_URL=http://127.0.0.1:8000/v1
# STT_API_KEY=
# STT_MODEL=whisper-1
# STT_TIMEOUT_MS=30000
# STT_MAX_BYTES=8000000

# Server-side text-to-speech. Needed when the device has no voice for the answer
# language — common for Indian languages on desktop Linux. Any OpenAI-compatible
# /audio/speech endpoint.
# TTS_BASE_URL=http://127.0.0.1:8000/v1
# TTS_API_KEY=
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=alloy
# TTS_FORMAT=mp3
# TTS_MAX_CHARS=2000

# `node scripts/fake-voice.mjs` serves both endpoints on 127.0.0.1:8788 so the
# wiring can be checked without a key or a model download.

# ---- Supabase (optional — enables writing the AI tables) --------------------
# Without these, /api/answer still answers; it just reports
# persist_errors: ["persistence_disabled"].
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Pre-existing: report extraction (src/app/api/process-report) -----------
GEMINI_API_KEY=
